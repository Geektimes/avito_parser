# Токен Telegram-бота от @BotFather
BOT_TOKEN=0000000000:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Список chat_id получателей уведомлений (через запятую).
# Узнать свой: напишите боту /id.
ADMIN_IDS=123456789

# Путь к SQLite парсера (для команды /stats). В docker-compose мапится
# общий volume ./data, так что по умолчанию работает «из коробки».
# DB_PATH=data/avito.db

# Порт HTTP-эндпоинта /notify (не пробрасывается наружу).
# NOTIFY_PORT=8080
