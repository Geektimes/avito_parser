; Персональный конфиг уведомлений (в .gitignore!). Скопируйте как monitor.ini
; и заполните. Без файла мониторинг работает, просто без уведомлений.
;
; url — HTTP-эндпоинт avito-бота внутри docker-сети (avito-bot:8080/notify).
; Токен и список chat_id бот берёт из переменных окружения (см. .env.example).

[notify]
; URL моста до бота. Пусто = уведомления выключены.
url = http://avito-bot:8080
; Фильтр локации: варианты через запятую, логика «ИЛИ», подстрока без
; учёта регистра. Пусто = присылать все новые лоты.
location_filter = Волгоград, Волгоградская область
